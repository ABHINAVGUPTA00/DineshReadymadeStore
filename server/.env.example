PORT=5000
# Razorpay Credentials (Get these from Razorpay Dashboard -> Settings -> API Keys)
RAZORPAY_KEY_ID=your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here

# Firebase Admin SDK Credentials
# Download this from Firebase Project Settings -> Service Accounts -> Generate New Private Key
# We will use this to securely connect to your Firestore database as an admin
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=your_client_email
FIREBASE_PRIVATE_KEY="your_private_key"
